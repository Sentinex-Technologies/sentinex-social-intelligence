# ============================================================================
# SENTINEX SOCIAL INTELLIGENCE - Environment Configuration
# SIH26152 - NTRO Problem Statement
# ============================================================================
# 
# IMPORTANT: This is a TEMPLATE file
# 1. Copy to .env: cp .env.example .env
# 2. Replace placeholder values with real credentials (if using live data)
# 3. NEVER commit .env to git (already in .gitignore)
# 
# ============================================================================

# ============================================================================
# 🎯 DATA COLLECTION MODE (MOST IMPORTANT SETTING)
# ============================================================================
# 
# Choose: 'synthetic' or 'live'
# 
# ✅ For SIH Demo (RECOMMENDED):
#    DATA_MODE=synthetic
#    - FREE, fast, 100% reliable
#    - No API keys needed
#    - Legal, no ToS violations
#    - Perfect for hackathon evaluation
# 
# 🔄 For Production (Post-SIH):
#    DATA_MODE=live
#    - Requires API keys (see sections below)
#    - Reddit/RSS are free
#    - Twitter costs $100/month
# 
DATA_MODE=synthetic

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite (Current - Development/Demo)
DATABASE_URL=sqlite:///./data/sentinex.db

# PostgreSQL (Future - Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinex

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# Backend API Server
API_HOST=0.0.0.0
API_PORT=8002
API_BASE_URL=http://localhost:8002
API_DEBUG=True
API_RELOAD=True

# CORS (Cross-Origin Resource Sharing)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

ENVIRONMENT=development
DEBUG=True

# Security (generate strong keys for production)
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
JWT_SECRET=dev_jwt_secret_change_in_production

# ============================================================================
# SYNTHETIC DATA GENERATOR (Used when DATA_MODE=synthetic)
# ============================================================================

# Random seed for reproducible data generation
SYNTHETIC_DATA_SEED=42

# Dataset size
SYNTHETIC_USERS=100
SYNTHETIC_POSTS=1000
SYNTHETIC_DAYS_BACK=30

# ============================================================================
# LIVE DATA SCRAPERS (Used when DATA_MODE=live) - POST-SIH ONLY
# ============================================================================
# 
# Only configure these if you're switching to live data after SIH.
# For SIH demo, leave these as placeholders.
# 
# ============================================================================

# ----------------------------------------------------------------------------
# Reddit API - FREE ✅ (Recommended first choice)
# ----------------------------------------------------------------------------
# Setup Instructions:
#   1. Go to: https://www.reddit.com/prefs/apps
#   2. Click "Create App" → Select "script"
#   3. Name: Sentinex Social Intelligence
#   4. Redirect URI: http://localhost:8002
#   5. Copy client_id (under app name) and client_secret
#   6. Paste below
# 
# Time to setup: 15 minutes
# Cost: FREE forever
# Rate limit: 600 requests per 10 minutes (plenty!)
# Legal: ✅ Official API

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=Sentinex/1.0

# ----------------------------------------------------------------------------
# Telegram API - FREE ✅
# ----------------------------------------------------------------------------
# Setup Instructions:
#   1. Go to: https://my.telegram.org/apps
#   2. Login with your phone number
#   3. Create new application
#   4. Copy api_id and api_hash
#   5. Paste below
# 
# Time to setup: 20 minutes
# Cost: FREE forever
# Works with: Public channels only (e.g. @BBCNews, @TechCrunch)
# Legal: ✅ Official API

TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ----------------------------------------------------------------------------
# Twitter/X API - PAID 💰 (Optional - Only if budget allows)
# ----------------------------------------------------------------------------
# Setup Instructions:
#   1. Go to: https://developer.twitter.com
#   2. Apply for API access (requires approval)
#   3. Subscribe to Basic plan ($100/month)
#   4. Get Bearer Token
#   5. Paste below
# 
# Time to setup: 1 hour (includes approval wait)
# Cost: $100/month minimum
# Legal: ✅ Official API

TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# ----------------------------------------------------------------------------
# RSS Feeds - FREE ✅ (Easiest option!)
# ----------------------------------------------------------------------------
# No setup needed! RSS scraper works out of the box.
# Includes: BBC, TechCrunch, Hacker News, Guardian, NYT, Reddit RSS, etc.
# 
# Time to setup: 0 minutes (already configured)
# Cost: FREE forever
# Legal: ✅ Public feeds

# No API keys needed for RSS feeds!

# ----------------------------------------------------------------------------
# Instagram/Facebook - NOT SUPPORTED ❌
# ----------------------------------------------------------------------------
# Instagram and Facebook scraping is:
# - Technically impossible (anti-bot protection)
# - Legally prohibited (ToS violation)
# - Requires business approval (takes months)
# 
# Recommendation: DO NOT attempt. Use Reddit/Telegram instead.

# ============================================================================
# NLP / ML CONFIGURATION
# ============================================================================

# Sentiment Analysis
SENTIMENT_MODEL=vader
# Options: vader (fast, good for social media), textblob, transformers

# Language Detection
DEFAULT_LANGUAGE=en

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=logs/sentinex.log

# ============================================================================
# OPTIONAL FEATURES (Future enhancements)
# ============================================================================

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# Data Retention
DATA_RETENTION_DAYS=30

# Redis Cache (Future - Production)
# REDIS_URL=redis://localhost:6379/0

# Email Notifications (Future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@sentinex.ai
# SMTP_PASSWORD=your_smtp_password

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8002

# ============================================================================
# 🎯 QUICK START GUIDE
# ============================================================================
# 
# For SIH Demo (Current):
# -----------------------
# 1. Copy this file: cp .env.example .env
# 2. No changes needed! Default DATA_MODE=synthetic is perfect.
# 3. Run: ./START.sh
# 4. Demo at: http://localhost:5173
# 
# After SIH (Live Data):
# ----------------------
# 1. Change: DATA_MODE=live
# 2. Setup Reddit API (15 min, free)
# 3. Setup Telegram API (20 min, free)
# 4. Optional: Setup Twitter API ($100/month)
# 5. Run: ./START.sh
# 6. System will use live data!
# 
# ============================================================================
# END OF CONFIGURATION
# ============================================================================
