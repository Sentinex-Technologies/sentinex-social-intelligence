# ============================================================
# SENTINEX SOCIAL INTELLIGENCE - Environment Variables
# ============================================================
# 
# IMPORTANT: This is a TEMPLATE file only.
# 
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit .env to git (it's in .gitignore)
# 
# ============================================================

# ============================================================
# SOCIAL MEDIA API CREDENTIALS
# ============================================================
# DO NOT COMMIT REAL VALUES - TEMPLATE ONLY

# X (Twitter) API
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# SQLite (Development)
DATABASE_URL=sqlite:///./sentinex.db

# PostgreSQL (Production - Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinex

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Environment
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=your_secret_key_here_min_32_characters
JWT_SECRET=your_jwt_secret_here

# ============================================================
# API SERVER CONFIGURATION
# ============================================================

# Backend API
API_HOST=localhost
API_PORT=8000
API_BASE_URL=http://localhost:8000

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ============================================================
# DATA PROCESSING
# ============================================================

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# Data Retention (days)
DATA_RETENTION_DAYS=30

# ============================================================
# NLP / ML CONFIGURATION
# ============================================================

# Sentiment Analysis Model
SENTIMENT_MODEL=vader
# Options: vader, textblob, transformers

# Language Detection
DEFAULT_LANGUAGE=en

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=logs/sentinex.log

# ============================================================
# DEMO / DEVELOPMENT
# ============================================================

# Use synthetic data (for demo/development)
USE_DEMO_DATA=True

# Demo dataset size
DEMO_DATA_SIZE=100

# ============================================================
# OPTIONAL SERVICES
# ============================================================

# Redis (for caching - future)
# REDIS_URL=redis://localhost:6379/0

# Email notifications (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password

# ============================================================
# END OF CONFIGURATION
# ============================================================
